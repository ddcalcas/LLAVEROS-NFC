<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ficha Digital de Mascota</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: #f4f6f8;
            color: #333;
            display: flex;
            justify-content: center;
            padding: 20px 15px;
        }

        .card {
            background: #ffffff;
            width: 100%;
            max-width: 400px;
            border-radius: 24px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            overflow: hidden;
            text-align: center;
            padding-bottom: 25px;
        }

        .header-bg {
            background: linear-gradient(135deg, #4F46E5, #7C3AED);
            height: 100px;
            width: 100%;
        }

        .profile-img {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            border: 5px solid #ffffff;
            object-fit: cover;
            margin-top: -65px;
            background-color: #eee;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }

        .pet-name {
            font-size: 26px;
            font-weight: 800;
            margin-top: 10px;
            color: #1F2937;
        }

        .pet-breed {
            font-size: 14px;
            color: #6B7280;
            margin-bottom: 20px;
            font-weight: 500;
        }

        .alert-badge {
            background-color: #FEF2F2;
            color: #DC2626;
            border: 1px solid #FCA5A5;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 20px;
        }

        .info-group {
            text-align: left;
            padding: 0 25px;
            margin-bottom: 20px;
        }

        .info-item {
            background-color: #F9FAFB;
            padding: 12px 16px;
            border-radius: 12px;
            margin-bottom: 10px;
            border: 1px solid #E5E7EB;
        }

        .info-label {
            font-size: 11px;
            text-transform: uppercase;
            color: #9CA3AF;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .info-value {
            font-size: 15px;
            color: #374151;
            font-weight: 600;
            margin-top: 2px;
        }

        .actions {
            padding: 0 25px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-decoration: none;
            padding: 14px;
            border-radius: 14px;
            font-weight: 700;
            font-size: 16px;
            transition: transform 0.2s;
        }

        .btn:active {
            transform: scale(0.98);
        }

        .btn-ws {
            background-color: #25D366;
            color: white;
        }

        .btn-call {
            background-color: #4F46E5;
            color: white;
        }

        .footer-logo {
            margin-top: 25px;
            font-size: 12px;
            color: #9CA3AF;
        }
    </style>
</head>
<body>

    <div class="card">
        <div class="header-bg"></div>
        
        <!-- Foto de la Mascota -->
        <img src="https://images.unsplash.com/photo-1543466835-00a7907e9de1?w=500" alt="Mascota" class="profile-img">

        <!-- Nombre y Raza -->
        <h1 class="pet-name">Firulais 🐾</h1>
        <p class="pet-breed">Golden Retriever • 2 años</p>

        <!-- Mensaje de Extravío -->
        <div class="alert-badge">
            🚨 ¡Si me encontraste, por favor contacta a mi dueño!
        </div>

        <!-- Información Útil -->
        <div class="info-group">
            <div class="info-item">
                <div class="info-label">Propietario</div>
                <div class="info-value">Yair Romero</div>
            </div>
            <div class="info-item">
                <div class="info-label">Ubicación / Ciudad</div>
                <div class="info-value">Cocula, Jalisco</div>
            </div>
            <div class="info-item">
                <div class="info-label">Notas / Cuidados Especiales</div>
                <div class="info-value">Es muy amigable pero asustadizo. Requiere medicamento diario.</div>
            </div>
        </div>

        <!-- Botones de Contacto Rápido -->
        <div class="actions">
            <!-- Cambia el número después de whatsapp.com/send?phone= (incluye la clave del país sin el símbolo +) -->
            <a href="https://api.whatsapp.com/send?phone=5213131123084&text=Hola!%20Encontré%20a%20tu%20mascota%20Firulais." class="btn btn-ws" target="_blank">
                💬 Mandar WhatsApp
            </a>
            <a href="tel:+523131123084" class="btn btn-call">
                📞 Llamar por Teléfono
            </a>
        </div>

        <div class="footer-logo">
            Identificación Inteligente NFC DDCALCAS
        </div>
    </div>

</body>
</html>
